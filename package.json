{
  "name": "daily-task-panel",
  "version": "0.5.13",
  "description": "Obsidian sidebar panel: daily-note capture to project execution over the Tasks plugin.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src",
    "rollback:prod": "node scripts/rollback-prod.mjs",
    "release:patch": "npm version patch && npm run deploy:prod",
    "release:minor": "npm version minor && npm run deploy:prod"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "gtd",
    "daily-notes"
  ],
  "author": "Sean Han",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "svelte": "^5.56.10",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SeanYHan888/obsidian-daily-task-panel.git"
  }
}
